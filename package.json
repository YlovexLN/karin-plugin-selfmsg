{
  "name": "karin-plugin-selfmsg",
  "version": "0.0.1",
  "description": "让 Karin 接受 OneBot11 的 message_sent（上报自身消息）事件，使其进入插件层；用于同账号多框架场景下让 kkk 收到其它框架发出的链接",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0",
    "karin": ">=1.8.0"
  },
  "karin": {
    "main": "index.js",
    "apps": [
      "apps"
    ],
    "web": "./web.config.js",
    "files": [
      "config"
    ]
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "karin",
    "karin-plugin",
    "onebot11",
    "message_sent",
    "bilibili",
    "kkk"
  ],
  "author": "YlovexLN",
  "license": "AGPL-3.0-only",
  "private": true,
  "devDependencies": {
    "eslint": "^9.0.0",
    "neostandard": "^0.11.0"
  }
}
